# Copy this file to `.env` in the repo root and fill in the values below.
# docker-compose.yml reads these to configure the local Postgres/Mongo/Redis
# containers and the `api` container itself.

# --- Local Postgres container credentials ---
# Only used to bootstrap the local `postgres` docker-compose service on
# first run — pick any values, they don't need to match anything external.
POSTGRES_USER=farmcircle
POSTGRES_PASSWORD=farmcircle
POSTGRES_DB=farmcircle

# --- Database connection strings ---
# The hostnames below (postgres/mongo/redis) are the docker-compose service
# names — correct when the `api` container talks to them over the internal
# docker network, which is the normal way to run this locally (`docker
# compose up`). If you instead run the API natively on the host (`npm run
# start:dev` outside Docker), swap these to `localhost` instead, since
# docker-compose still publishes each port to the host.
DATABASE_URL=postgresql://farmcircle:farmcircle@postgres:5432/farmcircle
MONGO_URL=mongodb://mongo:27017/farmcircle
REDIS_URL=redis://redis:6379

# --- JWT secrets ---
# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_SECONDS=604800

# --- Google OAuth ---
# Create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials, and add
# http://localhost:3000/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Signs the OAuth "state" param (CSRF protection on the redirect flow) — any
# random string works. Generate with: openssl rand -hex 32
GOOGLE_OAUTH_STATE_SECRET=

# --- Frontend origin, for CORS ---
# Must exactly match the URL the web/ dev server actually runs on, no
# trailing slash — used as the Access-Control-Allow-Origin value.
FRONTEND_URL=http://localhost:3001

# --- Razorpay (test mode) ---
# Get test-mode keys from https://dashboard.razorpay.com (Settings > API Keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only meaningfully exercised if you've set up a Razorpay Dashboard webhook
# pointed at a tunnel (e.g. ngrok) to this API — otherwise any placeholder
# value is fine, since nothing will actually call POST /payments/webhook
# on a plain local setup.
RAZORPAY_WEBHOOK_SECRET=

# Loose on purpose for local dev/e2e (the api container also runs the e2e
# suite, which calls /auth/login many times per run). Leave this unset
# entirely in any environment meant to resemble production — the code
# defaults to a strict 5-per-60s limit when it's unset.
AUTH_THROTTLE_LIMIT=1000
