# Copy this file to `.env` (or `.env.local`, which Next.js also picks up
# automatically and is never committed even without .gitignore rules) inside
# web/ and adjust if needed.

# Base URL of the running NestJS API (see the root .env.example — this
# should match its GOOGLE_CALLBACK_URL/PORT setup). Defaults to this same
# value if the variable is unset, so mainly change it if your API runs on a
# different host/port — e.g. testing over your LAN, where this needs to be
# your machine's LAN IP instead of localhost, since a browser on another
# device can't resolve "localhost" to your machine.
NEXT_PUBLIC_API_URL=http://localhost:3000
